# Crie uma chave em https://console.groq.com/keys
# Cada colaborador deve criar seu proprio .env e usar sua propria chave.
GROQ_API_KEY=
GROQ_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Modelos exibidos no seletor, separados por virgula.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile

# auto prefere o modelo de voz mais rapido disponível; use int8 para economizar espaço.
ORACULO_VOICE_MODEL=auto

HOME_ASSISTANT_URL=http://homeassistant.local:8123
HOME_ASSISTANT_TOKEN=
# Tudo que nao estiver nesta lista sera bloqueado.
HOME_ASSISTANT_ALLOWED_ENTITIES=light.sala,switch.escritorio
